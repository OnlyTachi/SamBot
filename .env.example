# ==============================================================================
# DISCORD & IDENTIDADE
# ==============================================================================
DISCORD_TOKEN=seu_token_do_bot_aqui
OWNER_ID=seu_id_aqui

# ==============================================================================
# DISCORD OAUTH2 (Caso for utilizar API/Dashboard)
# ==============================================================================
DISCORD_CLIENT_ID=seu_client_id_do_discord_aqui
DISCORD_CLIENT_SECRET=seu_client_secret_do_discord_aqui

# ==============================================================================
# API INTERNA SAMBOT
# ==============================================================================
# Chave mestra esperada nos headers (X-Bot-Token / X-API-Token)
API_SECRET_TOKEN=sambot_secret_token_industrial_2026

# ==============================================================================
# TELEGRAM USER-CLIENT (Telethon MTProto)
# ==============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=seu_telegram_api_id
TELEGRAM_API_HASH=seu_telegram_api_hash
TELEGRAM_CHANNELS=-1001234567890,@canal_promocoes

# ==============================================================================
# PERSISTÊNCIA & BANCOS DE DADOS
# ==============================================================================
# Meilisearch
MEILI_HOST="http://meilisearch:7700"
MEILI_MASTER_KEY=sua_chave_master_meilisearch_aqui

# Navidrome / Subsonic API
NAVIDROME_URL="http://navidrome:4533"
NAVIDROME_USER="seu_usuario_ou_usuario_da_sua_bot"
NAVIDROME_PASSWORD=sua_senha_do_navidrome_aqui

# ==============================================================================
# SERVIÇOS DE DOWNLOAD EXTERNO (caso tenha)
# ==============================================================================
YT_WORKER_URL="http://127.0.0.1:4000"

# ==============================================================================
# CHAVES DE FERRAMENTAS & PESQUISA
# ==============================================================================
# Twitch / IGDB
IGDB_CLIENT_ID=seu_twitch_client_id
IGDB_CLIENT_SECRET=seu_twitch_client_secret

# Google Custom Search (Web Search)
GOOGLE_SEARCH_API_KEY=sua_chave_google_search
GOOGLE_SEARCH_CX=seu_search_engine_cx

# Brave Search (Fallback Web)
BRAVE_SEARCH_API_KEY=sua_chave_brave_aqui

# Busca de Imagens & Giphy
PIXABAY_API_KEY=sua_chave_pixabay
GIPHY_API_KEY=sua_chave_giphy

# Google Shopping & Scraping (Opcional - SerpApi)
SERPAPI_KEY=sua_chave_serpapi_aqui

# Jellyfin (Streaming de Mídia Local)
JELLYFIN_URL="http://jellyfin:8096"
JELLYFIN_API_KEY=sua_chave_de_api_jellyfin

# ==============================================================================
# PROVEDORES DE IA / LLM (Cadeia com Failover Automático)
# ==============================================================================
# Google Gemini (Suporta múltiplas chaves rotativas com GEMINI_API_KEY_N)
GEMINI_API_KEY=sua_chave_gemini_principal
GEMINI_API_KEY_1=sua_chave_gemini_reserva_1
GEMINI_API_KEY_2=sua_chave_gemini_reserva_2

# Groq Cloud
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# DeepSeek
DEEPSEEK_API_KEY=sk-sua_chave_deepseek_aqui

# Mistral AI
MISTRAL_API_KEY=sua_chave_mistral_aqui

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-sua_chave_openrouter_aqui

# Ollama Remoto (Deixe vazio caso utilize apenas Docker/Local)
OLLAMA_REMOTE_URL=
MODEL_SMART_REMOTE=phi3.5:latest